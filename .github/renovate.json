{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":separateMajorReleases",
        ":ignoreUnstable",
        "helpers:pinGitHubActionDigests"
    ],
    "labels": [
        "dependencies"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^container-scan/action\\.yml$/"],
            "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+: (?<currentValue>v\\d+\\.\\d+\\.\\d+)" ]
        }
    ],
    "packageRules": [
        {
            "description": "GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions",
            "labels": [
                "dependencies",
                "github-actions"
            ]
        }
    ],
    "rebaseWhen": "conflicted"
}
