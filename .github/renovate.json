{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":separateMajorReleases",
        ":ignoreUnstable",
        "helpers:pinGitHubActionDigests"
    ],
    "labels": [
        "dependencies"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^container-scan/action\\.yml$/", "/^jactionlint/action\\.yml$/"],
            "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+: (?<currentValue>v\\d+\\.\\d+\\.\\d+)" ]
        }
    ],
    "packageRules": [
        {
            "description": "GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions",
            "labels": [
                "dependencies",
                "github-actions"
            ]
        },
        {
            "description": "Automerge action digest and patch updates once every CI check passes",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "digest",
                "pinDigest",
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "rebase",
            "platformAutomerge": false,
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "Scanner versions change security results and CI does not run them; review manually",
            "matchDepNames": [
                "aquasecurity/trivy",
                "docker/scout-cli"
            ],
            "automerge": false
        }
    ],
    "rebaseWhen": "behind-base-branch"
}
